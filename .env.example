# MedRouter configuration
# Copy to .env for local development:  cp .env.example .env
# Values shown are the development defaults unless noted.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development            # development | production
PORT=3000                      # Go HTTP port
BASE_PATH=                     # e.g. /medrouter to serve under a path prefix
PUBLIC_ORIGIN=http://localhost:5173  # Browser origin; must match the frontend
SYSTEM_NAME=MedRouter
# Comma-separated proxy CIDRs; leave empty to ignore X-Forwarded-* headers.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Sessions (required in production)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Production requires at least 32 characters.
SESSION_SECRET=
SESSION_COOKIE_NAME=medrouter_session
# Defaults to true when APP_ENV=production.
SESSION_COOKIE_SECURE=
SESSION_TTL_DAYS=30
SESSION_TOUCH_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
REGISTER_ENABLED=true

# Optional one-time bootstrap of a root account. Leave empty to skip.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Empty SQL_DSN uses SQLite at SQLITE_PATH. PostgreSQL example:
# SQL_DSN=postgres://user:password@localhost:5432/medrouter?sslmode=disable
SQL_DSN=
SQLITE_PATH=data/medrouter.db
DB_MAX_OPEN_CONNS=10

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_ENABLED=true
# Debug mode logs the code instead of sending mail. Forbidden in production
# unless ALLOW_EMAIL_DEBUG_IN_PRODUCTION=true.
EMAIL_DEBUG_MODE=true
ALLOW_EMAIL_DEBUG_IN_PRODUCTION=false

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MedRouter <no-reply@medrouter.local>
SMTP_TLS_MODE=implicit         # implicit (465) | starttls (587) | none
SMTP_TIMEOUT_SECONDS=10

VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_IP_HOURLY_LIMIT=10

# ---------------------------------------------------------------------------
# OAuth (all optional; buttons appear for configured providers only)
# ---------------------------------------------------------------------------
# Callback: ${PUBLIC_ORIGIN}${BASE_PATH}/api/oauth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=SSO
OIDC_SCOPES=openid email profile

# Defaults to PUBLIC_ORIGIN + BASE_PATH when empty. Set this when the public
# callback origin differs (for example behind a reverse proxy).
OAUTH_REDIRECT_BASE=

# ---------------------------------------------------------------------------
# Rate limits (per instance, in memory)
# ---------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5

# ---------------------------------------------------------------------------
# Model library (CubeStack ModelVersion / InferenceRuntimeProfile)
# ---------------------------------------------------------------------------
# The API is public. When disabled, /api/models returns available=false with
# reason DISABLED instead of failing.
MODEL_LIBRARY_ENABLED=true
# Positive snapshot TTL in seconds. Failures use a short negative cache, and a
# stale snapshot is served for a bounded window when a refresh fails.
MODEL_LIBRARY_CACHE_TTL_SECONDS=30
# Timeout for one Kubernetes API refresh (both list calls share it).
MODEL_LIBRARY_REQUEST_TIMEOUT_SECONDS=5
# Kubernetes API endpoint. Leave empty in-cluster (service account token + CA).
# For local development run `kubectl proxy --port=8001` and set:
#   MODEL_LIBRARY_API_URL=http://127.0.0.1:8001
MODEL_LIBRARY_API_URL=

# ---------------------------------------------------------------------------
# Dataset library (CubeStack Dataset)
# ---------------------------------------------------------------------------
# Independent of the model library: either one can be unavailable without
# affecting the other. When disabled, /api/datasets returns available=false
# with reason DISABLED.
DATASET_LIBRARY_ENABLED=true
DATASET_LIBRARY_CACHE_TTL_SECONDS=30
DATASET_LIBRARY_REQUEST_TIMEOUT_SECONDS=5
# Empty falls back to MODEL_LIBRARY_API_URL (so `kubectl proxy` covers both).
DATASET_LIBRARY_API_URL=
